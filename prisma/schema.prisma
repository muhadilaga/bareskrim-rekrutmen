// ============================================================
// Database Schema - Sistem Rekrutmen Bareskrim Polri Roblox
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma Migrate & schema engine memakai koneksi langsung / session pooler,
  // bukan transaction pooler (Supabase memisahkan dua jalur ini).
  directUrl = env("DIRECT_URL")
}

enum QuestionType {
  MCQ
  ESSAY
}

enum AttemptStatus {
  LULUS
  TIDAK_LULUS
}

enum BlacklistCategory {
  POLRI
  PENDIDIKAN
}

enum ApplicationStatus {
  MENUNGGU_VERIFIKASI
  DITERIMA
  DITOLAK
}

enum Gender {
  L
  P
}

enum VerdictStatus {
  LULUS
  TIDAK_LULUS
}

// ------------------------------------------------------------
// Casis / Peserta (teridentifikasi dari Roblox ID)
// ------------------------------------------------------------
model User {
  id              String   @id @default(cuid())
  robloxId        BigInt   @unique
  username        String   @unique
  displayName     String
  discordUsername String?
  avatarUrl       String?
  profileUrl      String?
  // Snapshot keanggotaan dari verifikasi Roblox terakhir
  requiredGroupId    BigInt?
  policeGroupRankId  BigInt?
  policeGroupRank    String? // nama role di grup Kepolisian, mis. "BRIGADIR POLISI"
  policeGroupRankNumber Int? // urutan pangkat numerik di grup (untuk gerbang rank minimal)
  bannedGroupIds     Json? // array Int dari grup matra terlarang (jika tidak kosong => diblokir)
  matraBlocked       Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  attempts   ExamAttempt[]
  attendances Attendance[]
  applications Application[]

  @@index([username])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Periode Rekrutmen (reset & pengacakan soal antar periode)
// ------------------------------------------------------------
model ExamPeriod {
  id          String   @id @default(cuid())
  recruitmentPeriodId String?
  recruitmentPeriod   RecruitmentPeriod? @relation(fields: [recruitmentPeriodId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isActive    Boolean  @default(false)
  isAttendanceOpen Boolean @default(false) // Admin kontrol kapan absen bisa dilakukan
  isExamOpen  Boolean  @default(false) // Admin kontrol kapan ujian bisa dikerjakan
  examStartTime DateTime? // Waktu mulai ujian (jika null, ujian bisa dimulai kapan saja saat isExamOpen)
  examEndTime   DateTime? // Waktu tutup ujian (jika null, tidak ada batas waktu selain durasi)
  seed        Int      @unique // seed acak -> menentukan subset & urutan soal periode ini
  // Konfigurasi periode (opsional; null = pakai nilai default di constants.ts)
  mcqCount     Int? // jumlah soal pilihan ganda yang keluar
  essayCount   Int? // jumlah soal essay yang keluar
  passThreshold Int  @default(70) // nilai minimum untuk LULUS (KKM)
  openedAt    DateTime? @default(now())
  closedAt    DateTime?
  deletedAt   DateTime?

  attempts   ExamAttempt[]
  attendances Attendance[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([recruitmentPeriodId])
}

// ------------------------------------------------------------
// Bank Soal (sumber soal; periode baru mengambil subset acak)
// ------------------------------------------------------------
model Question {
  id          String       @id @default(cuid())
  type        QuestionType
  prompt      String
  // MCQ : [{ "key": "A", "text": "..." }, ...] (kunci A-D)
  // ESSAY: tidak digunakan
  options     Json?
  // Kunci jawaban benar (hanya MCQ)
  correctKey  String?
  // Nilai per soal
  points      Int
  // Kata kunci untuk auto-grading essay, mis. ["reserse", "kriminal"]
  keywords    Json?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  answers ExamAnswer[]

  @@index([type, isActive])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Percobaan Ujian (1x per periode per casis)
// ------------------------------------------------------------
model ExamAttempt {
  id          String   @id @default(cuid())
  periodId    String
  userId      String
  attemptKey  String   @unique // `${periodId}_${userId}` mencegah percobaan ganda
  // Snapshot soal yang benar-benar disajikan ke casis (sudah diacak).
  // Berisi correctKey/keywords utk grading SERVER-SIDE. TIDAK pernah dikirim ke client.
  questionsJson  Json
  savedAnswers   Json?   // jawaban sementara (auto-save sebelum submit)
  flaggedQuestions Json?   // pertanyaan yang diflag oleh user
  bookmarkedQuestions Json? // pertanyaan yang di-bookmark oleh user
  startedAt      DateTime @default(now())
  submittedAt    DateTime?
  deletedAt      DateTime?

  period ExamPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers ExamAnswer[]
  result  ExamResult?

  @@unique([periodId, userId])
  @@index([userId])
  @@index([periodId])
  @@index([submittedAt])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Jawaban per soal (arsip & rekap untuk instruktur)
// ------------------------------------------------------------
model ExamAnswer {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  answer       String // jawaban terpilih (kunci MCQ) atau teks essay
  isCorrect    Boolean?
  earnedPoints Int?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ------------------------------------------------------------
// Hasil Ujian (nilai akhir + status KKM)
// ------------------------------------------------------------
model ExamResult {
  id              String        @id @default(cuid())
  attemptId       String        @unique
  score           Int
  maxScore        Int
  mcqScore        Int
  essayScore      Int
  status          AttemptStatus
  passed          Boolean
  answersJson     Json // rekap detail jawaban + penilaian (untuk Discord & halaman hasil)
  discordMessageId String? // ID pesan Discord webhook, agar bisa dihapus bersama rekap
  submittedAt     DateTime      @default(now())
  deletedAt       DateTime?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Daftar Hitam (Blacklist Polri / Pendidikan)
// Pengganti pembacaan channel Discord; dikelola via panel admin.
// ------------------------------------------------------------
model BlacklistEntry {
  id        String           @id @default(cuid())
  category  BlacklistCategory
  username  String
  reason    String?
  createdAt DateTime         @default(now())

  @@index([category])
  @@index([username])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Putusan Sidang (informasional, tidak memblokir otomatis)
// ------------------------------------------------------------
model VerdictEntry {
  id        String        @id @default(cuid())
  username  String
  status    VerdictStatus
  note      String?
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([username])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Absensi Try Out (1x per periode per casis)
// ------------------------------------------------------------
model Attendance {
  id            String   @id @default(cuid())
  userId        String?  // nullable: diisi saat user login pertama kali
  periodId      String
  tahap         String   @default("AKADEMIK") // AKADEMIK = ujian+interview+fisik
  status        String   @default("HADIR")
  discordUserId String?  // Username Discord untuk assign role & linking
  motivation    String?
  motivationStatus String? // APPROVED | REVIEW | REJECTED
  motivationReason String?
  motivationAttemptCount Int @default(1)
  roleEligible  Boolean  @default(false)
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period ExamPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([userId, periodId, tahap])
  @@index([periodId])
  @@index([discordUserId])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Audit Log - jejak aksi instruktur/admin di panel
// ------------------------------------------------------------
model AdminLog {
  id        String   @id @default(cuid())
  action    String // mis. "BUKA_PERIODE", "HAPUS_CASIS", "TUTUP_PERIODE"
  target    String? // target yang terkena aksi (username / nama periode / ID)
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([target])
}

// Audit Log - jejak aksi siswa (absen, mulai ujian, submit)
// ------------------------------------------------------------
model StudentActionLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // "ATTENDANCE", "EXAM_START", "EXAM_SUBMIT"
  periodId  String?
  attemptId String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([periodId])
  @@index([attemptId])
}

// ------------------------------------------------------------
// Antrean Laporan Discord yang gagal terkirim (retry otomatis)
// ------------------------------------------------------------
model PendingDiscordReport {
  id        String   @id @default(cuid())
  resultId  String   @unique
  payload   Json // ExamReportInput yang akan dikirim
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Periode Pendaftaran (terpisah dari ExamPeriod; tidak mengubah
// sistem ujian existing). Tiap pendaftaran melekat pada 1 periode.
// ------------------------------------------------------------
model RecruitmentPeriod {
  id         String    @id @default(cuid())
  code       String    @unique // prefix registrasi, mis. "XLI-02"
  name       String    // mis. "Angkatan XLI Gelombang 02"
  openedAt   DateTime
  closedAt   DateTime
  isActive   Boolean   @default(false) // gerbang on/off admin (kompatibel gaya ExamPeriod)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  applications Application[]
  examPeriods  ExamPeriod[]

  @@index([isActive])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Pendaftaran Calon Siswa (Pusdik Reserse)
// CATATAN KEAMANAN:
// - accessTokenHash = SHA-256(raw token). Raw token TIDAK PERNAH
//   disimpan di DB dan tidak pernah dicetak ke log.
// - robloxUsername adalah input teks BELUM TERVERIFIKASI sampai
//   proses verifikasi Roblox/Student Dashboard selesai.
// - Satu pendaftaran per identitas Roblox per periode dijamin oleh
//   @@unique([recruitmentPeriodId, robloxUsernameKey]) di tingkat
//   database (race-safe, menangani concurrent submission).
// ------------------------------------------------------------
model Application {
  id                   String            @id @default(cuid())
  recruitmentPeriodId  String
  registrationId       String            @unique // Format: XLI-02-K8M2N4 (6 char base32, contoh)
  accessTokenHash      String            @unique // SHA-256 hash dari raw access token
  fullName             String
  robloxUsername       String            // tampilan asli (belum diverifikasi)
  robloxUsernameKey    String            // lowercase normalisasi utk uniqueness
  discordId            String
  birthDate            DateTime
  gender               Gender
  origin               String
  experience           String            @db.Text
  motivation           String            @db.Text
  agreementAcceptedAt  DateTime          @default(now())
  status               ApplicationStatus @default(MENUNGGU_VERIFIKASI)
  rejectionReason      String?           @db.Text
  verifiedAt           DateTime?
  verifiedBy           String?

  userId               String?
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  recruitmentPeriod    RecruitmentPeriod @relation(fields: [recruitmentPeriodId], references: [id])

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  @@unique([recruitmentPeriodId, robloxUsernameKey])
  @@index([registrationId])
  @@index([robloxUsername])
  @@index([discordId])
  @@index([status])
  @@index([recruitmentPeriodId])
  @@index([deletedAt])
}

// ------------------------------------------------------------
// Pengaturan runtime (key-value JSON) — disimpan lewat raw SQL
// di src/lib/runtime-settings.ts (INSERT ... ON CONFLICT).
// Struktur mengikuti kontrak SQL existing (TABLE_SQL lama):
//   "key" TEXT NOT NULL (PK), "value" JSONB NOT NULL,
//   "updatedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP.
// Nama tabel/kolom identik tanpa @map (Prisma memetakan langsung).
// ------------------------------------------------------------
model RuntimeSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

// ------------------------------------------------------------
// Temporary OAuth State Storage (Server-Side Multi-Instance PKCE & Replay Guard)
// ------------------------------------------------------------
model OAuthState {
  id           String    @id @default(cuid())
  stateId      String    @unique
  state        String    @unique
  codeVerifier String
  nonce        String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

